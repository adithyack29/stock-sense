# StockSense Environment Variables Reference

# Database Configuration (Optional)
# If left empty, StockSense uses the bundled pre-seeded SQLite database in /tmp on Vercel serverless.
# Provide a PostgreSQL connection string for persistent multi-instance database hosting (e.g. Neon, Supabase).
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-1.aws.neon.tech/stocksense?sslmode=require

# CORS Configuration (Optional)
# Comma-separated list of allowed origins. Vercel *.vercel.app domains and localhost:5173 are allowed by default.
# ALLOWED_ORIGINS=https://stocksense.vercel.app,https://mycustomdomain.com

# Frontend API URL (Optional)
# If frontend is deployed separately from backend, specify the backend API URL.
# By default, frontend makes relative requests to '/api'.
# VITE_API_URL=https://stocksense.vercel.app/api
